# Copy this file to .env (or .env.local) at the repository root and fill it in. Never commit the copy.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox). ALIGN Pay refuses anything but sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A free Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# ALIGN_PAY_LEDGER=align           # connect your own ALIGN workspace (through `align mcp`) instead of the sample ledger
# ALIGN_CLI="npx -y @align-agent/cli@0.1.7"
# GEMINI_MODEL=gemini-3.6-flash    # the support agent and limit drafting (a Pro model, if your key allows it)
# GEMINI_FAST_MODEL=gemini-3.6-flash  # one-line reasons on held and blocked cards
# PORT=3000
