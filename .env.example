# Copy this file to .env (or .env.local) at the repository root and fill it in. Never commit the copy.

# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox). ALIGN Pay refuses anything but sandbox.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# A free Gemini API key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional
# ALIGN_PAY_LEDGER=auto            # auto | align | fixtures (auto tries ALIGN's MCP server, then fixtures)
# ALIGN_CLI="npx -y @align-agent/cli@0.1.7"
# ALIGN_PAY_CONFIRMED_LIMITS=      # path to an owner-confirmed-limits.json written by the owner's setup
# GEMINI_PRO_MODEL=gemini-2.5-pro
# GEMINI_FLASH_MODEL=gemini-2.5-flash
# PORT=3000
